# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Google Drive API (Service Account JSON key path & Root Folder ID)
GOOGLE_APPLICATION_CREDENTIALS=./credentials.json
GDRIVE_ROOT_FOLDER_ID=your_google_drive_root_folder_id

# Database (PostgreSQL або SQLite для локального тестування)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/call_qa
# DATABASE_URL=sqlite+aiosqlite:///./call_qa.db

# Налаштування поллінгу та шляхів
POLLING_INTERVAL_SECONDS=60
CONFIG_YAML_PATH=./config.yaml
TEMP_DOWNLOAD_DIR=/tmp/call_qa_audio
LOG_LEVEL=INFO

